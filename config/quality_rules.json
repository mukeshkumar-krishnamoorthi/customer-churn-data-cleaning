{
  "schema": {
    "gender": "string",
    "SeniorCitizen": "numeric",
    "tenure": "numeric",
    "MonthlyCharges": "numeric",
    "TotalCharges": "numeric",
    "Churn": "string"
  },
  "not_null": ["gender", "tenure", "MonthlyCharges", "TotalCharges", "Churn"],
  "missing_warn_pct": 5,
  "duplicates_allowed": true,
  "numeric_strings": ["TotalCharges"],
  "ranges": {
    "MonthlyCharges": { "min": 0 },
    "tenure": { "min": 0, "max": 100 },
    "SeniorCitizen": { "min": 0, "max": 1 }
  },
  "categories": {
    "gender": ["Male", "Female"],
    "Churn": ["Yes", "No"],
    "SeniorCitizen": [0, 1]
  },
  "unique": [],
  "consistency": [
    {
      "type": "product_match",
      "a": "tenure",
      "b": "MonthlyCharges",
      "target": "TotalCharges",
      "tolerance_pct": 15
    }
  ]
}
